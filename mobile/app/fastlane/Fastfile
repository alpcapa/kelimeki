# İmzalı .ipa üretimi + TestFlight yüklemesi (FAZ C 24.2).
#
# ⚠ BU DOSYA HENÜZ HİÇ KOŞMADI. App Store Connect API anahtarı Apple'ın
# indirme ucundaki bir arıza yüzünden alınamadı (üç Team Key yakıldı, bkz.
# marketing/app-store/console-formlari.md § 3). Yani "yazıldı" ile
# "çalışıyor" arasındaki fark burada GERÇEK — ilk koşu bir doğrulama
# turudur, rutin bir yayın değil.
#
# Mac YOK (geliştirici iPad'den çalışıyor). Sertifika ve profil bu yüzden
# elle değil `match` ile, App Store Connect API üzerinden üretiliyor.

default_platform(:ios)

platform :ios do
  desc "İmzalı .ipa üret ve TestFlight'a yükle"
  lane :beta do
    # ⚠ ŞART, süs değil (9 Eylül 2026'da koşu #606 bunu kanıtladı):
    # `match` sertifikayı bir ANAHTARLIĞA kuruyor ve taze bir macOS
    # runner'ında öyle bir anahtarlık YOK. Öncesinde iş akışı elle
    # `MATCH_KEYCHAIN_NAME=kelimeki-ci` diyordu ama o anahtarlığı KİMSE
    # oluşturmuyordu; `match` "Could not locate the provided keychain"
    # diyerek düştü — üstelik git klonlamayı, şifre çözmeyi ve Apple
    # kimlik doğrulamasını GEÇTİKTEN sonra, yani hata çok geç çıkıyordu.
    #
    # `setup_ci` fastlane'in bu iş için yazılmış action'ı: geçici bir
    # anahtarlık oluşturur, açar, varsayılan yapar, kilit zaman aşımını
    # kaldırır ve `MATCH_KEYCHAIN_NAME`/`MATCH_KEYCHAIN_PASSWORD`i KENDİSİ
    # ayarlar. Bu yüzden iş akışındaki elle export'lar KALDIRILDI —
    # dursalardı setup_ci'nin anahtarlığını ezip aynı hatayı geri
    # getirirlerdi. (`MATCH_PASSWORD` AYRI bir şey: o, depo şifreleme
    # parolası, duruyor.)
    setup_ci

    # API anahtarı ortamdan; hiçbiri repoda durmuyor (depo PUBLIC).
    anahtar = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_P8"),
      is_key_content_base64: false,
      in_house: false
    )

    # Sertifika + profil. readonly:false ÇÜNKÜ ilk koşuda henüz hiçbir şey
    # yok — match'in üretip depoya yazması gerekiyor. Sonraki koşular aynı
    # sertifikayı yeniden kullanır (Apple'ın sayı sınırı bu yüzden var).
    match(type: "appstore", api_key: anahtar, readonly: false)

    # ⚠ `flutter build ios` BU LANE'DEN ÖNCE, iş akışında koşuyor.
    # Sebep: `--dart-define` ile verilen derleme kimliği ve Supabase
    # anahtarları orada geçiliyor (bkz. mobile-build.yml → "iOS derle").
    # Burada yalnızca Xcode arşivi alınıp imzalanıyor.
    # ⚠ YOLLAR `mobile/app`e GÖRE — `mobile/app/ios`a değil (9 Eylül 2026,
    # koşu #608'de ölçüldü). Fastlane, `fastlane/` klasörünü İÇEREN dizine
    # geçiyor; burada o dizin `mobile/app`. Flutter projelerinin çoğunda
    # `fastlane/` `ios/`un altında durur ve o yüzden örneklerde yol
    # `"Runner.xcworkspace"` diye geçer — bu depoda `fastlane/` bir üst
    # dizinde, dolayısıyla `ios/` öneki ŞART.
    #   önce: workspace "Runner.xcworkspace"  → .../mobile/app/Runner.xcworkspace  ✗
    #   sonra: workspace "ios/Runner.xcworkspace"                                   ✓
    # Aynı hata `output_directory`de TERS yöndeydi: `"../build/..."`
    # `mobile/build`e çıkıyordu, oysa iş akışının artefakt adımı `.ipa`yı
    # `mobile/app/build/ios/ipa`da arıyor.
    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "build/ios/ipa",
      clean: false,
      # `match` profili kurdu ve eşlemeyi `MATCH_PROVISIONING_PROFILE_MAPPING`e
      # yazdı; burada AÇIKÇA tekrarlamak gym'in otomatik okumasına
      # güvenmemek demek — imzalama hatası bu zincirin en pahalı turu
      # (her deneme bir macOS koşusu).
      export_options: {
        provisioningProfiles: {
          "com.kelimeki.kelimeki" => "match AppStore com.kelimeki.kelimeki"
        }
      }
    )

    # skip_waiting_for_build_processing: Apple'ın işleme süresi 10-40 dk
    # arasında değişiyor ve CI'ı orada beklemek macOS runner dakikası yakar.
    # Paket yüklendi mi sorusu App Store Connect'ten okunur.
    upload_to_testflight(
      api_key: anahtar,
      skip_waiting_for_build_processing: true
    )
  end
end
