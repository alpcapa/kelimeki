<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Kelimeki</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>kelimeki</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<!-- Custom şema (kelimeki://): Supabase auth dönüş linkleri — bugün
		     şifre sıfırlama (kelimeki://reset), ileride davet gibi diğer
		     dönüşler. Universal Links'in aksine Apple hesabı/AASA dosyası
		     gerektirmez. supabase_flutter gelen URI'yi app_links üzerinden
		     kendisi yakalar (bkz. mobile/CLAUDE.md, şifre sıfırlama parçası). -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLName</key>
				<string>com.kelimeki.kelimeki</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>kelimeki</string>
				</array>
			</dict>
		</array>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- ABD ihracat mevzuatı (EAR) beyanı. `false` = "hiç şifreleme yok"
		     DEĞİL; "yalnızca MUAF şifreleme var" demek: işletim sisteminin
		     standart HTTPS/TLS'i. Kelimeki'nin tüm trafiği Supabase/Firebase/
		     Brevo uçlarına HTTPS ile gidiyor, kendi kripto algoritması yok,
		     yerel veri özel bir şifreyle saklanmıyor.
		     Bu anahtar OLMADAN Apple soruyu HER yüklemede tekrar sorar ve paket
		     cevaplanana kadar "Missing Compliance"ta bekler, testçilere
		     dağıtılmaz. Kullanıcı onayı: 8 Eylül 2026.
		     Ayrıntı: marketing/app-store/console-formlari.md § 12. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- Uygulama kapalı/arka plandayken gelen push'un Dart tarafına
		     ulaşabilmesi için. Bu anahtar olmadan iOS sessiz/veri taşıyan
		     bildirimleri uygulamaya HİÇ teslim etmez; kullanıcıya banner
		     görünür ama firebase_messaging'in arka plan işleyicisi çalışmaz.
		     Android'de karşılığı yok (orada FCM servisi her durumda uyanır).
		     Entitlements ile birlikte gelir: Runner/Runner.entitlements. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
		<!-- Hesap Ayarları'ndaki profil fotoğrafı değiştirme (image_picker,
		     yalnızca galeri — kamera izni BİLİNÇLİ istenmiyor, bkz.
		     mobile/CLAUDE.md). -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Profil fotoğrafı seçmek için fotoğraflarına erişim gerekiyor.</string>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<!-- ⚠ DÖRDÜ DE BİLDİRİLMEK ZORUNDA — Apple'ın kuralı, tercih değil.
		     9 Eylül 2026, koşu #612: imzalı .ipa üretildi ve Apple YÜKLEMEDE
		     reddetti (90474): "you need to include all of the … orientations
		     to support iPad multitasking". `TARGETED_DEVICE_FAMILY = "1,2"`
		     olduğu sürece (iPad destekleniyor, mağaza vitrininde iPad seti
		     de var) bu liste kısaltılamaz.
		     ⚠ SONUCU: uygulama iPad'de DÖNDÜRÜLEBİLİR olur. `main.dart`in
		     `setPreferredOrientations([portraitUp])` kilidi iPhone'da
		     tutuyor, ama çoklu göreve açık bir iPad uygulamasında iOS o
		     kilidi yok sayıyor — `UIRequiresFullScreen` ile kapatmak da
		     modern SDK'larda güvenilir değil. Portta manzara için ayrı bir
		     düzen YOK; cihazda görülmesi gereken bir madde olarak
		     mobile/TESTING.md'ye yazıldı. -->
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
